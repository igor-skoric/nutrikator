# Copy to .env on the server. Do not commit .env.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
SITE_URL=https://nutrikator.rs

# Optional extras, comma-separated. These hosts are already allowed:
# nutrikator.rs, www.nutrikator.rs, nutrikator.rs.itbranch.rs
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Turn on only after the proxy sends X-Forwarded-Proto: https
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
